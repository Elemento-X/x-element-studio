# ─────────────────────────────────────────────────────────────────────
# Elemento-X Studio — environment template
#
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local`. Validation lives in `config/env.ts` (Zod, fail-fast).
#
# Strict prod checks fire when:
#   - NODE_ENV === 'production'
#   - NEXT_PHASE !== 'phase-production-build'   (build is permissive)
# ─────────────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────────────
# 'development' | 'production' | 'test'
# DEV default: development. Prod is set by the platform (Vercel) at runtime.
NODE_ENV=development

# Public site URL — used for absolute links, structured data, CORS check.
# Must be HTTPS in production. Localhost is OK in dev.
# DEV default: http://localhost:3000
# PROD: https://<your-domain> after the domain is purchased (deferred).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Contact form ────────────────────────────────────────────────────
# Kill-switch. Strict enum: must be literally "true" or "false".
# Enum (not coerced boolean) because `Boolean("false") === true` would
# silently flip the switch — see config/env.ts comment.
# When `true` in prod, RESEND/NOTION/UPSTASH envs become required.
# DEV: set to `true` to render the form at /#contact (otherwise the
#      section falls back to mailto buttons).
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false

# Per-IP rate limit (requests / hour). Default 5.
# Reasonable starting point; tune later if abuse patterns warrant.
CONTACT_RATE_LIMIT_PER_HOUR=5

# Global cap (requests / hour, all IPs combined). Default 200.
# Defends against IPv6 /64 rotation that bypasses the per-IP cap — without
# this, an attacker can drain Resend free tier (100/day) by rotating IPs.
# Tune in tandem with the email provider's quota: this cap should sit
# safely below the daily email send limit.
CONTACT_GLOBAL_LIMIT_PER_HOUR=200

# Per-email cap (requests / hour, same submitter email). Default 2.
# Catches attackers who rotate IPs but reuse a single email (targeted
# spam). Email is SHA-256'd before keying — plaintext never reaches Redis.
CONTACT_EMAIL_LIMIT_PER_HOUR=2


# ── Email — Resend ──────────────────────────────────────────────────
# Only Resend is wired today. If we ever swap providers, this enum
# gates the switch (config/env.ts).
EMAIL_PROVIDER=resend

# Get from https://resend.com/api-keys (server-side only — never NEXT_PUBLIC_*)
# DEV: leave blank → notify.ts runs in stub mode (logs only, no send).
# PROD: required when the form is enabled.
# ROTATION: every 6 months OR immediately on any leak suspicion.
#   Procedure: docs/runbooks/secret-rotation.md.
RESEND_API_KEY=

# From address for outgoing notifications. Format:
#   "Display Name <user@domain>"  OR  "user@domain"
# DEV: `Elemento-X <onboarding@resend.dev>` — Resend's verified sandbox
#      sender; works without owning a domain. Sandbox can ONLY send to
#      the email registered on the Resend account (anti-spam restriction).
# PROD: MUST be a verified sender on a domain you control (SPF + DKIM
#      published). Otherwise Resend silently rejects every send and the
#      operator gets zero notifications — leads pile up in Notion only.
#      Boot validation rejects the dev sandbox in prod.
FROM_EMAIL=Elemento-X <onboarding@resend.dev>

# Where contact submissions get notified (operator inbox).
# DEV: any inbox you control (e.g. xelementcontact@gmail.com).
# PROD: team inbox, never a personal Gmail. Boot rejects the dev default.
NOTIFY_EMAIL=xelementcontact@gmail.com


# ── Persistence — Notion ────────────────────────────────────────────
# Internal integration token: https://www.notion.so/my-integrations
# ROTATION: every 6 months OR immediately on leak suspicion. The token
#   only sees DBs explicitly connected to the integration, so blast
#   radius is the connected workspace. Procedure: docs/runbooks/secret-rotation.md.
NOTION_API_KEY=

# Target database ID. Required properties:
#   - Name              (title)
#   - Email             (email)
#   - Company           (rich_text, optional)
#   - Engagement        (select: New project | Diagnostic | Partnership | Other)
#   - Engagement detail (rich_text, optional)
#   - Message           (rich_text)
#   - Status            (select: New | Contacted | Closed)
#   - IP hash           (rich_text, 16 hex chars — SHA-256 prefix, no plaintext)
#   - Source            (select: landing-form; future entry points add tags)
NOTION_DATABASE_ID=


# ── Anti-bot — Cloudflare Turnstile (optional) ──────────────────────
# Defense in depth alongside honeypot + 3-layer rate-limit. When EITHER
# key is missing, the form skips Turnstile entirely (graceful degrade).
#
# DEV: leave blank → no widget rendered, no server verify.
#   OR use Cloudflare's test keys to exercise the full path locally:
#     NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA  (always passes)
#     TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# PROD: real keys from https://www.cloudflare.com/products/turnstile/
#   ROTATION: every 12 months OR on leak. Site key is public (NEXT_PUBLIC_*).
#   Secret key is server-only — never log, never echo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── Rate-limit storage — Upstash Redis ──────────────────────────────
# In dev, leave blank → in-memory adapter is used (resets on restart).
# In prod, configure via Vercel Marketplace → Upstash Redis OR sign up
# at upstash.com directly. Marketplace auto-injects both vars; manual
# setup needs you to add them in Vercel project envs.
#
# URL must match: https://<id>.upstash.io  (regex anchored — anti-SSRF)
# ROTATION: every 12 months OR immediately on leak suspicion. Blast
#   radius is the rate-limit Redis only (no PII stored). Procedure:
#   docs/runbooks/secret-rotation.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Observability — Sentry (optional, not yet wired) ────────────────
# Stub at lib/observability/sentry.ts. To enable:
#   1. npm install @sentry/nextjs
#   2. Set SENTRY_DSN below (Vercel envs in prod).
#   3. Wire initSentry() in instrumentation.ts (see file header).
# Leave blank to keep no-op (zero runtime weight).
SENTRY_DSN=
